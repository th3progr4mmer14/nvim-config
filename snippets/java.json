  "Spring Boot: manejador global de errores": {
    "prefix": "sbadvice",
    "description": "@RestControllerAdvice con ProblemDetail",
    "body": [
      "import org.springframework.http.HttpStatus;",
      "import org.springframework.http.ProblemDetail;",
      "import org.springframework.web.bind.MethodArgumentNotValidException;",
      "import org.springframework.web.bind.annotation.ExceptionHandler;",
      "import org.springframework.web.bind.annotation.RestControllerAdvice;",
      "",
      "@RestControllerAdvice",
      "public class ${1:${TM_FILENAME_BASE}} {",
      "",
      "\t@ExceptionHandler(MethodArgumentNotValidException.class)",
      "\tpublic ProblemDetail validacion(MethodArgumentNotValidException ex) {",
      "\t\tProblemDetail problem = ProblemDetail.forStatus(HttpStatus.BAD_REQUEST);",
      "\t\tproblem.setTitle(\"Datos inválidos\");",
      "\t\tex.getBindingResult().getFieldErrors()",
      "\t\t\t.forEach(e -> problem.setProperty(e.getField(), e.getDefaultMessage()));",
      "\t\treturn problem;",
      "\t}",
      "",
      "\t@ExceptionHandler(${2:IllegalArgumentException}.class)",
      "\tpublic ProblemDetail ${3:argumentoInvalido}(${2:IllegalArgumentException} ex) {",
      "\t\treturn ProblemDetail.forStatusAndDetail(HttpStatus.${4:BAD_REQUEST}, ex.getMessage());",
      "\t}",
      "}"
    ]
  },
